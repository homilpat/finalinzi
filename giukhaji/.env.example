# ─────────────────────────────────────────────
# giukhaji 환경변수 템플릿
# 이 파일을 복사해 giukhaji/.env 로 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 gitignore 대상이라 커밋되지 않습니다.
# 모든 키는 없어도 검사 자체는 동작하며, 아래 표기대로 폴백됩니다.
# ─────────────────────────────────────────────

# 펭트 AI 고급 답변용 (OpenAI). 없으면 로컬 규칙 기반 응답만 사용.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ASSISTANT_MODEL=gpt-4.1-mini

# 전화번호 해시 솔트 / Flask 세션 시크릿. 배포 시 반드시 교체.
# 로컬에서는 누락 시 임시값을 생성하지만 Render 운영 환경에서는 반드시 필요합니다.
PHONE_HASH_SALT=change-this-local-salt
SECRET_KEY=change-this-flask-secret

# 지남력 검사 GPS 장소 채점용 (카카오 로컬 REST API).
# 없으면 브라우저 GPS 역지오코딩 비활성 → 폰 네이티브 Geocoder / 기본정보 수동입력으로 폴백.
# 발급: https://developers.kakao.com → 앱 → REST API 키
KAKAO_REST_API_KEY=your-kakao-rest-api-key
